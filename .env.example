# Configuración del Servidor MiFacturaDigital.com.ve
# Copia este archivo como .env en tu servidor de producción (Railway, Render, VPS, Cloud Run)
# NUNCA subas el archivo .env real a repositorios públicos.

PORT=3000

# Base de Datos y Autenticación Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pasarelas de Pago Internacionales (Opcionales)
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
LEMONSQUEEZY_API_KEY=
MERCADOPAGO_ACCESS_TOKEN=

# Envío Automático de Comprobantes PDF por Correo (Opcionales)
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM=
SMTP_WEBHOOK_URL=

# Seguridad y Red
# Mantener en false solo si el certificado del BCV presenta cadena incompleta en el servidor Node; true para verificación estricta TLS
BCV_TLS_STRICT=false
ALLOWED_ORIGIN=
